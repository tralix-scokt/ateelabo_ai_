MONGO_URI=mongodb://127.0.0.1:27017/ateelabo
JWT_SECRET=
OPENAI_API_KEY=
GEMINI_API_KEY=
ADMIN_EMAIL=
PORT=5000
CORS_ORIGINS=http://localhost:5173

# Generate a unique secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-2.5-flash
USER_DAILY_REQUESTS=100
GUEST_DAILY_REQUESTS=20
GLOBAL_DAILY_REQUESTS=1000
# Set only to the IPs/CIDRs of your trusted reverse proxy, never arbitrary clients.
TRUST_PROXY=
